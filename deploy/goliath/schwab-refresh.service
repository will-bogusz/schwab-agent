[Unit]
Description=Refresh Schwab OAuth tokens

[Service]
Type=oneshot
WorkingDirectory=%h/tmp/schwab
Environment=SCHWAB_AGENT_DIR=%h/tmp/schwab
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Headed under Xvfb, NOT --headless: Schwab's Akamai edge rejects headless
# Chromium ("Access Denied") before the login form renders. The headed
# browser with the trusted persistent profile completes login + consent
# unattended; the keepalive re-logins proactively at 5 days so the 7-day
# refresh-token cliff is never reached.
ExecStart=/usr/bin/xvfb-run -a --server-args=-screen 0 1280x900x24 %h/.local/bin/uv run schwab-auth-keepalive --app all --browser-fallback --headed
